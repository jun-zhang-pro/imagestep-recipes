{
  "name": "ImageStep recipe — social carousel: Sheet row → 4 cards, same character → URLs back",
  "nodes": [
    {
      "parameters": {
        "pollTimes": { "item": [{ "mode": "everyMinute" }] },
        "documentId": { "__rl": true, "mode": "list", "value": "REPLACE_WITH_SPREADSHEET_ID", "cachedResultName": "Carousel" },
        "sheetName": { "__rl": true, "mode": "list", "value": "gid=0", "cachedResultName": "Sheet1" },
        "event": "rowAdded",
        "options": {}
      },
      "id": "a1b2c3d4-0001-4c00-8000-000000000001",
      "name": "Google Sheets Trigger",
      "type": "n8n-nodes-base.googleSheetsTrigger",
      "typeVersion": 1,
      "position": [0, 0],
      "credentials": { "googleSheetsTriggerOAuth2Api": { "id": "REPLACE_ME", "name": "Google Sheets Trigger account" } }
    },
    {
      "parameters": {
        "resource": "op",
        "operation": "run",
        "op": "generate",
        "inputMode": "none",
        "prompt": "={{ $json.headline }}. {{ $json.subline }}. Social carousel card, the character from the reference images as the hero, clean background with room for text, 4:5 portrait.",
        "count": 4,
        "parameters": "{\"aspectRatio\": \"4:5\"}",
        "dryRun": false,
        "wait": true,
        "waitSeconds": 300,
        "publish": true,
        "downloadOutput": false,
        "options": { "presetId": "REPLACE_WITH_YOUR_PRESET_ID", "folder": "carousel" }
      },
      "id": "a1b2c3d4-0002-4c00-8000-000000000002",
      "name": "Generate 4 Cards",
      "type": "n8n-nodes-imagestep.imageStep",
      "typeVersion": 1,
      "position": [260, 0],
      "credentials": { "imageStepApi": { "id": "REPLACE_ME", "name": "ImageStep account" } }
    },
    {
      "parameters": {
        "jsCode": "// One row per sheet row: the four published URLs as url1..url4 plus the job id.\nreturn $input.all().map((item) => {\n  const urls = (item.json.outputs || []).map((o) => o.publicUrl);\n  return {\n    json: {\n      row_number: $('Google Sheets Trigger').item.json.row_number,\n      jobId: item.json.jobId,\n      status: item.json.status,\n      url1: urls[0] || '',\n      url2: urls[1] || '',\n      url3: urls[2] || '',\n      url4: urls[3] || ''\n    }\n  };\n});"
      },
      "id": "a1b2c3d4-0003-4c00-8000-000000000003",
      "name": "Four URLs Per Row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [520, 0]
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": { "__rl": true, "mode": "list", "value": "REPLACE_WITH_SPREADSHEET_ID", "cachedResultName": "Carousel" },
        "sheetName": { "__rl": true, "mode": "list", "value": "gid=0", "cachedResultName": "Sheet1" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "row_number": "={{ $json.row_number }}",
            "url1": "={{ $json.url1 }}",
            "url2": "={{ $json.url2 }}",
            "url3": "={{ $json.url3 }}",
            "url4": "={{ $json.url4 }}",
            "jobId": "={{ $json.jobId }}",
            "status": "={{ $json.status }}"
          },
          "matchingColumns": ["row_number"],
          "schema": [
            { "id": "row_number", "displayName": "row_number", "type": "number", "required": false, "defaultMatch": true, "display": true, "canBeUsedToMatch": true, "readOnly": true, "removed": false },
            { "id": "headline", "displayName": "headline", "type": "string", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true },
            { "id": "subline", "displayName": "subline", "type": "string", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true },
            { "id": "url1", "displayName": "url1", "type": "string", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true },
            { "id": "url2", "displayName": "url2", "type": "string", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true },
            { "id": "url3", "displayName": "url3", "type": "string", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true },
            { "id": "url4", "displayName": "url4", "type": "string", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true },
            { "id": "jobId", "displayName": "jobId", "type": "string", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true },
            { "id": "status", "displayName": "status", "type": "string", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0004-4c00-8000-000000000004",
      "name": "Write URLs Back",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [780, 0],
      "credentials": { "googleSheetsOAuth2Api": { "id": "REPLACE_ME", "name": "Google Sheets account" } }
    }
  ],
  "connections": {
    "Google Sheets Trigger": { "main": [[{ "node": "Generate 4 Cards", "type": "main", "index": 0 }]] },
    "Generate 4 Cards": { "main": [[{ "node": "Four URLs Per Row", "type": "main", "index": 0 }]] },
    "Four URLs Per Row": { "main": [[{ "node": "Write URLs Back", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {},
  "meta": { "templateCredsSetupCompleted": false }
}
